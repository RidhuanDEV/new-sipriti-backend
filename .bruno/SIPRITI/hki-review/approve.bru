post {
  url: {{host}}/api/hki-review/:id/approve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: {{hki_id}}
}

body:json {
  {
    "catatan": "Memenuhi kriteria administrasi"
  }
}

