meta {
  name: delete
  type: http
  seq: 6
}

delete {
  url: {{host}}/api/mitra-kerja-riset/:id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: {{mitra_id}}
}

docs {
  # Delete Mitra Kerja Riset
  
  ## API Endpoint
  `DELETE /api/mitra-kerja-riset/:id`
  
  **Auth Required:** ✅ Bearer Token  
  **Role Required:** Admin
  
  ---
  
  ## DTO (Path Parameters)
  
  | Param | Type | Required | Description |
  |-------|------|----------|-------------|
  | id | UUID | ✅ | ID mitra |
  
  ---
  
  ## Response Structure
  
  ### Success (200 OK)
  ```json
  {
    "success": true,
    "message": "Berhasil menghapus mitra kerja riset"
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|---------|  
  | 401 | Token tidak valid |
  | 403 | Akses ditolak |
  | 404 | Mitra tidak ditemukan |
}
