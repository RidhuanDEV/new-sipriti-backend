meta {
  name: Get Output By ID
  type: http
  seq: 4
}

get {
  url: {{host}}/api/outputs/:id
  body: none
  auth: inherit
}

params:path {
  id: your-output-uuid-here
}

docs {
  # GET /api/outputs/:id

  Mengambil detail satu output berdasarkan ID.

  ## Path Parameters

  | Parameter | Type | Description |
  |-----------|------|-------------|
  | id | UUID | ID output yang ingin diambil |

  ## Response Success (200)

  ```json
  {
    "success": true,
    "message": "Data output berhasil diambil",
    "data": {
      "id": "uuid",
      "nama": "Jurnal Internasional Bereputasi",
      "kode": "JIB",
      "createdAt": "2025-01-08T00:00:00.000Z",
      "updatedAt": "2025-01-08T00:00:00.000Z"
    }
  }
  ```

  ## Error Responses

  | Status | Message |
  |--------|---------|
  | 404 | Output tidak ditemukan |
}
