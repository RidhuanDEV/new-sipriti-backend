meta {
  name: Get All Outputs
  type: http
  seq: 1
}

get {
  url: {{host}}/api/outputs
  body: none
  auth: inherit
}

params:query {
  ~page: 1
  ~limit: 10
  ~search: Jurnal
  ~sortBy: created_at
  ~sortOrder: DESC
}

docs {
  # GET /api/outputs

  Mengambil daftar semua master data output (jenis luaran).

  ## Query Parameters

  | Parameter | Type | Default | Description |
  |-----------|------|---------|-------------|
  | page | number | 1 | Halaman saat ini |
  | limit | number | 10 | Jumlah item per halaman |
  | search | string | "" | Cari berdasarkan nama output |
  | sortBy | string | "created_at" | Field untuk sorting |
  | sortOrder | string | "DESC" | ASC atau DESC |

  ## Response Success (200)

  ```json
  {
    "success": true,
    "message": "Data output berhasil diambil",
    "data": [
      {
        "id": "uuid",
        "nama": "Jurnal Nasional Terakreditasi",
        "kode": "JNT",
        "createdAt": "2025-01-08T00:00:00.000Z",
        "updatedAt": "2025-01-08T00:00:00.000Z"
      }
    ],
    "meta": {
      "pagination": {
        "currentPage": 1,
        "totalPages": 2,
        "totalItems": 15,
        "itemsPerPage": 10
      }
    }
  }
  ```
}
