meta {
  name: Get Usulan By ID
  type: http
  seq: 2
}

get {
  url: {{host}}/api/admin/usulan/:id
  body: none
  auth: inherit
}

params:path {
  id: your-usulan-uuid-here
}

docs {
  # GET /api/admin/usulan/:id
  
  Mengambil detail lengkap usulan termasuk anggota, RAB, dan dokumen pendukung.
  
  ## Path Parameters
  
  | Parameter | Type | Description |
  |-----------|------|-------------|
  | id | UUID | ID usulan yang ingin diambil |
  
  ## Response Success (200)
  
  ```json
  {
    "success": true,
    "message": "Detail usulan berhasil diambil",
    "data": {
      "id": "uuid",
      "judul": "Pengembangan Teknologi Informasi",
      "abstrak": "Abstrak penelitian...",
      "kata_kunci": "AI, Machine Learning, Big Data",
      "tipe_usulan": "Penelitian",
      "lama_kegiatan": "1 Tahun",
      "status": "Pending",
      "skema": {
        "id": "uuid",
        "nama_skema": "Penelitian Dasar",
        "tipe": "Penelitian"
      },
      "tahun_pelaksanaan": "2025",
      "ketua": {
        "id": "uuid",
        "name": "Dr. Ahmad Fauzi",
        "username": "ahmad.fauzi",
        "email": "ahmad@mail.com",
        "prodi": "Teknik Informatika",
        "institusi": "Institut Teknologi Indonesia"
      },
      "anggota": [
        {
          "id": "uuid",
          "peran": "Ketua",
          "status_undangan": "accepted",
          "user": {
            "id": "uuid",
            "name": "Dr. Ahmad Fauzi",
            "email": "ahmad@mail.com"
          }
        },
        {
          "id": "uuid",
          "peran": "Anggota",
          "status_undangan": "pending",
          "user": {
            "id": "uuid",
            "name": "Dr. Budi Santoso",
            "email": "budi@mail.com"
          }
        }
      ],
      "rabs": [
        {
          "id": "uuid",
          "komponen": "Peralatan",
          "total": 5000000
        },
        {
          "id": "uuid",
          "komponen": "Bahan Habis Pakai",
          "total": 3000000
        }
      ],
      "totalDana": 15000000,
      "dokumenPendukung": [
        {
          "id": "uuid",
          "nama": "proposal.pdf",
          "file_url": "/uploads/proposal/xxx.pdf"
        }
      ],
      "createdAt": "2025-01-08T00:00:00.000Z",
      "updatedAt": "2025-01-08T00:00:00.000Z"
    }
  }
  ```
  
  ## Response Error (404)
  ```json
  {
    "success": false,
    "message": "Usulan tidak ditemukan"
  }
  ```
}
