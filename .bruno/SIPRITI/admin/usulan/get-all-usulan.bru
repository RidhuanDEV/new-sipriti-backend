meta {
  name: Get All Usulan
  type: http
  seq: 1
}

get {
  url: {{host}}/api/admin/usulan
  body: none
  auth: inherit
}

params:query {
  ~page: 1
  ~limit: 10
  ~search: Pengembangan
  ~tahun: 2025
  ~skema: skema-uuid-here
  ~status: Pending
  ~tipe: Penelitian
  ~sortBy: created_at
  ~sortOrder: DESC
}

docs {
  # GET /api/admin/usulan
  
  Mengambil daftar semua usulan dengan pagination dan filter.
  
  ## Query Parameters
  
  | Parameter | Type | Default | Description |
  |-----------|------|---------|-------------|
  | page | number | 1 | Halaman saat ini |
  | limit | number | 10 | Jumlah item per halaman |
  | search | string | "" | Cari berdasarkan judul |
  | tahun | string | "" | Filter tahun pelaksanaan |
  | skema | UUID | "" | Filter berdasarkan skema_id |
  | status | string | "" | Filter: Draft, Pending, Approved, Declined |
  | tipe | string | "" | Filter: Penelitian, Pengabdian |
  | sortBy | string | "created_at" | Field untuk sorting |
  | sortOrder | string | "DESC" | ASC atau DESC |
  
  ## Response Success (200)
  
  ```json
  {
    "success": true,
    "message": "Data usulan berhasil diambil",
    "data": [
      {
        "id": "uuid",
        "no": 1,
        "ketua": "Dr. Ahmad Fauzi",
        "ketua_id": "user-uuid",
        "ketua_email": "ahmad@mail.com",
        "judul": "Pengembangan Teknologi Informasi",
        "jenisUsulan": "Penelitian Dasar",
        "skema_id": "skema-uuid",
        "tahunPelaksanaan": "2025",
        "status": "Pending",
        "tipe_usulan": "Penelitian",
        "createdAt": "2025-01-08T00:00:00.000Z",
        "updatedAt": "2025-01-08T00:00:00.000Z"
      }
    ],
    "meta": {
      "pagination": {
        "currentPage": 1,
        "totalPages": 5,
        "totalItems": 50,
        "itemsPerPage": 10,
        "hasNextPage": true,
        "hasPrevPage": false
      }
    }
  }
  ```
}
