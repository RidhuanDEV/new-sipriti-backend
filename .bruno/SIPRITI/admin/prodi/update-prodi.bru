meta {
  name: Update Prodi
  type: http
  seq: 4
}

put {
  url: {{host}}/api/admin/prodi/:id
  body: json
  auth: inherit
}

params:path {
  id: your-prodi-uuid-here
}

body:json {
  {
    "kode_prodi": "212025",
    "nama_prodi": "Teknik Elektro (Updated)",
    "jenjang": "S1"
