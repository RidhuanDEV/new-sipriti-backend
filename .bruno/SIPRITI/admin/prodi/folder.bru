meta {
  name: prodi
  seq: 1
}

docs {
  # Admin - Program Studi API
  
  Endpoint untuk mengelola data Program Studi.
  
  ## Struktur Data
  
  | Field | Type | Description |
  |-------|------|-------------|
  | id | UUID | Primary key |
  | kode_prodi | string | Kode prodi (unique, max 20 char) |
  | nama_prodi | string | Nama program studi |
  | jenjang | enum | D3, S1, S2, S3 |
  | createdAt | datetime | Tanggal dibuat |
  | updatedAt | datetime | Tanggal diupdate |
  
  ## Validation Rules
  - `kode_prodi` - Required, unique
  - `nama_prodi` - Required
  - `jenjang` - Required, enum: D3, S1, S2, S3
  
  ## Notes
  - Tidak dapat menghapus prodi yang masih memiliki user terkait
  - Kode prodi harus unik di seluruh sistem
}

auth {
  mode: inherit
}
