meta {
  name: Get All Prodi
  type: http
  seq: 1
}

get {
  url: {{host}}/api/admin/prodi
  body: none
  auth: inherit
}

params:query {
  ~page: 1
  ~limit: 10
  ~search: Teknik
  ~jenjang: S1
  ~sortBy: created_at
  ~sortOrder: DESC
}

docs {
  # GET /api/admin/prodi
  
  Mengambil daftar semua program studi dengan pagination dan filter.
  
  ## Query Parameters
  
  | Parameter | Type | Default | Description |
  |-----------|------|---------|-------------|
  | page | number | 1 | Halaman saat ini |
  | limit | number | 10 | Jumlah item per halaman |
  | search | string | "" | Cari berdasarkan nama/kode prodi |
  | jenjang | string | "" | Filter: D3, S1, S2, S3 |
  | sortBy | string | "created_at" | Field untuk sorting |
  | sortOrder | string | "DESC" | ASC atau DESC |
  
  ## Response Success (200)
  
  ```json
  {
    "success": true,
    "message": "Data prodi berhasil diambil",
    "data": [
      {
        "id": "uuid",
        "kode_prodi": "212020",
        "nama_prodi": "Teknik Informatika",
        "jenjang": "S1",
        "createdAt": "2025-01-08T00:00:00.000Z",
        "updatedAt": "2025-01-08T00:00:00.000Z"
      }
    ],
    "meta": {
      "pagination": {
        "currentPage": 1,
        "totalPages": 1,
        "totalItems": 7,
        "itemsPerPage": 10,
        "hasNextPage": false,
        "hasPrevPage": false
      }
    }
  }
  ```
  
  ## Response Error (401)
  ```json
  {
    "message": "Harap login terlebih dahulu"
  }
  ```
  
  ## Response Error (403)
  ```json
  {
    "message": "Akses ditolak: Anda bukan admin."
  }
  ```
}
