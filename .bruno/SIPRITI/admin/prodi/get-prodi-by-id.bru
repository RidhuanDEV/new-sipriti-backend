meta {
  name: Get Prodi By ID
  type: http
  seq: 2
}

get {
  url: {{host}}/api/admin/prodi/:id
  body: none
  auth: inherit
}

params:path {
  id: your-prodi-uuid-here
}

docs {
  # GET /api/admin/prodi/:id
  
  Mengambil detail program studi berdasarkan ID.
  
  ## Path Parameters
  
  | Parameter | Type | Description |
  |-----------|------|-------------|
  | id | UUID | ID prodi yang ingin diambil |
  
  ## Response Success (200)
  
  ```json
  {
    "success": true,
    "message": "Detail prodi berhasil diambil",
    "data": {
      "id": "uuid",
      "kode_prodi": "212020",
      "nama_prodi": "Teknik Informatika",
      "jenjang": "S1",
      "createdAt": "2025-01-08T00:00:00.000Z",
      "updatedAt": "2025-01-08T00:00:00.000Z"
    }
  }
  ```
  
  ## Response Error (404)
  ```json
  {
    "success": false,
    "message": "Prodi tidak ditemukan"
  }
  ```
}
