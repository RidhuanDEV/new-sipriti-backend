  name: Create Bidang Fokus
  type: http
  seq: 3
}

post {
  url: {{host}}/api/admin/bidang-fokus
  body: json
  auth: inherit
}

body:json {
  {
    "nama_bidang": "Kecerdasan Buatan"
  }
}

docs {
  # POST /api/admin/bidang-fokus
  
  Menambah bidang fokus baru.
  
  ## Request Body
  
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | nama_bidang | string | ✅ | Nama bidang fokus (1-100 karakter) |
  
  ## Response Success (201)
  
  ```json
  {
    "success": true,
    "message": "Bidang fokus berhasil ditambahkan",
    "data": {
      "id": "uuid",
      "nama_bidang": "Kecerdasan Buatan",
      "createdAt": "2025-01-08T00:00:00.000Z",
      "updatedAt": "2025-01-08T00:00:00.000Z"
    }
  }
  ```
}
