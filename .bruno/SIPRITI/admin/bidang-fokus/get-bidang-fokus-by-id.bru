meta {
  name: Get Bidang Fokus By ID
  type: http
  seq: 2
}

get {
  url: {{host}}/api/admin/bidang-fokus/:id
  body: none
  auth: inherit
}

params:path {
  id: your-bidang-fokus-uuid-here
}

docs {
  # GET /api/admin/bidang-fokus/:id
  
  Mengambil detail bidang fokus berdasarkan ID.
  
  ## Path Parameters
  
  | Parameter | Type | Description |
  |-----------|------|-------------|
  | id | UUID | ID bidang fokus yang ingin diambil |
  
  ## Response Success (200)
  
  ```json
  {
    "success": true,
    "message": "Detail bidang fokus berhasil diambil",
    "data": {
      "id": "uuid",
      "nama_bidang": "Teknologi Informasi",
      "createdAt": "2025-01-08T00:00:00.000Z",
      "updatedAt": "2025-01-08T00:00:00.000Z"
    }
  }
  ```
  
  ## Response Error (404)
  ```json
  {
    "success": false,
    "message": "Bidang fokus tidak ditemukan"
  }
  ```
}
