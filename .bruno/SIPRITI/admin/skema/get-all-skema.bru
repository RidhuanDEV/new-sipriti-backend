meta {
  name: Get All Skema
  type: http
  seq: 1
}

get {
  url: {{host}}/api/admin/skema
  body: none
  auth: inherit
}

params:query {
  ~page: 1
  ~limit: 10
  ~search: Penelitian
  ~tipe: Penelitian
  ~sortBy: created_at
  ~sortOrder: DESC
}

docs {
  # GET /api/admin/skema
  
  Mengambil daftar semua skema dengan pagination dan filter.
  
  ## Query Parameters
  
  | Parameter | Type | Default | Description |
  |-----------|------|---------|-------------|
  | page | number | 1 | Halaman saat ini |
  | limit | number | 10 | Jumlah item per halaman |
  | search | string | "" | Cari berdasarkan nama skema |
  | tipe | string | "" | Filter: Penelitian, Pengabdian, HKI |
  | sortBy | string | "created_at" | Field untuk sorting |
  | sortOrder | string | "DESC" | ASC atau DESC |
  
  ## Response Success (200)
  
  ```json
  {
    "success": true,
    "message": "Data skema berhasil diambil",
    "data": [
      {
        "id": "uuid",
        "nama_skema": "Penelitian Dasar",
        "tipe": "Penelitian",
        "deskripsi": "Skema penelitian untuk pengembangan ilmu dasar",
        "is_active": true,
        "createdAt": "2025-01-08T00:00:00.000Z",
        "updatedAt": "2025-01-08T00:00:00.000Z"
      }
    ],
    "meta": {
      "pagination": {
        "currentPage": 1,
        "totalPages": 1,
        "totalItems": 11,
        "itemsPerPage": 10,
        "hasNextPage": true,
        "hasPrevPage": false
      }
    }
  }
  ```
}
