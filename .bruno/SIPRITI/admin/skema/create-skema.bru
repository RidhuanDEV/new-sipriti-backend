meta {
  name: Create Skema
  type: http
  seq: 3
}

post {
  url: {{host}}/api/admin/skema
  body: json
  auth: inherit
}

body:json {
  {
    "nama_skema": "Penelitian AI & Machine Learning",
    "tipe": "Penelitian",
    "deskripsi": "Skema khusus untuk penelitian kecerdasan buatan"
  }
}

docs {
  # POST /api/admin/skema
  
  Menambah skema baru.
  
  ## Request Body
  
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | nama_skema | string | ✅ | Nama skema (unique) |
  | tipe | enum | ✅ | Penelitian, Pengabdian, HKI |
  | deskripsi | string | ❌ | Deskripsi skema |
  
  ## Response Success (201)
  
  ```json
  {
    "success": true,
    "message": "Skema berhasil ditambahkan",
    "data": {
      "id": "uuid",
      "nama_skema": "Penelitian AI & Machine Learning",
      "tipe": "Penelitian",
      "deskripsi": "Skema khusus untuk penelitian kecerdasan buatan",
      "is_active": true,
      "createdAt": "2025-01-08T00:00:00.000Z",
      "updatedAt": "2025-01-08T00:00:00.000Z"
    }
  }
  ```
  
  ## Response Error (409 - Conflict)
  ```json
  {
    "success": false,
    "message": "Nama skema 'Penelitian AI' sudah terdaftar"
  }
  ```
  
  ## Response Error (400 - Bad Request)
  ```json
  {
    "success": false,
    "message": "Tipe skema harus salah satu dari: Penelitian, Pengabdian, HKI"
  }
  ```
}
