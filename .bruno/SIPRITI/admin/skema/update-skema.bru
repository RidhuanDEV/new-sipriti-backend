meta {
  name: Update Skema
  type: http
  seq: 4
}

put {
  url: {{host}}/api/admin/skema/:id
  body: json
  auth: inherit
}

params:path {
  id: your-skema-uuid-here
}

body:json {
  {
    "nama_skema": "Penelitian AI & Machine Learning (Updated)",
    "tipe": "Penelitian",
    "deskripsi": "Updated description",
    "is_active": true
  }
}

docs {
  # PUT /api/admin/skema/:id
  
  Mengubah data skema.
  
  ## Path Parameters
  
  | Parameter | Type | Description |
  |-----------|------|-------------|
  | id | UUID | ID skema yang ingin diupdate |
  
  ## Request Body (semua field optional)
  
  | Field | Type | Description |
  |-------|------|-------------|
  | nama_skema | string | Nama skema baru (unique) |
  | tipe | enum | Penelitian, Pengabdian, HKI |
  | deskripsi | string | Deskripsi baru |
  | is_active | boolean | Status aktif |
  
  ## Response Success (200)
  
  ```json
  {
    "success": true,
    "message": "Skema berhasil diperbarui",
    "data": {
      "id": "uuid",
      "nama_skema": "Penelitian AI & Machine Learning (Updated)",
      "tipe": "Penelitian",
      "deskripsi": "Updated description",
      "is_active": true,
      "createdAt": "2025-01-08T00:00:00.000Z",
      "updatedAt": "2025-01-08T01:00:00.000Z"
    }
  }
  ```
}
