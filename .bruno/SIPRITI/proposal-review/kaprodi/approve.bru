post {
  url: {{host}}/api/proposal-review/:type/:id/approve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "catatan": "Catatan persetujuan Kaprodi"
  }
}

params:path {
  type: penelitian
