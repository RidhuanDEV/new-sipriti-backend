meta {
  name: get-by-id
  type: http
  seq: 3
}

get {
  url: {{host}}/api/product-riset/:id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: {{product_riset_id}}
}

docs {
  # Get Product Riset by ID
  
  ## API Endpoint
  `GET /api/product-riset/:id`
  
  **Auth Required:** ✅  
  **Role Required:** All authenticated users
  
  ---
  
  ## DTO (Path Parameters)
  
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | id | UUID | ✅ | ID product riset |
  
  ---
  
  ## Response Structure
  
  ### Success (200)
  ```json
  {
    "success": true,
    "message": "Berhasil mengambil detail product riset",
    "data": {
      "id": "uuid-product",
      "nama_produk": "Aplikasi Mobile Pendidikan",
      "createdAt": "2025-01-15T10:00:00.000Z",
      "updatedAt": "2025-01-15T10:00:00.000Z"
    }
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|--------|
  | 401 | Token tidak valid |
  | 404 | Product riset tidak ditemukan |
}
