meta {
  name: delete
  type: http
  seq: 6
}

delete {
  url: {{host}}/api/product-riset/:id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: {{product_riset_id}}
}

docs {
  # Delete Product Riset
  
  ## API Endpoint
  `DELETE /api/product-riset/:id`
  
  **Auth Required:** ✅  
  **Role Required:** Admin
  
  ---
  
  ## DTO (Path Parameters)
  
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | id | UUID | ✅ | ID product riset |
  
  ---
  
  ## Response Structure
  
  ### Success (200)
  ```json
  {
    "success": true,
    "message": "Product riset berhasil dihapus",
    "data": null
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|--------|
  | 401 | Token tidak valid |
  | 403 | Akses ditolak |
  | 404 | Product riset tidak ditemukan |
}
