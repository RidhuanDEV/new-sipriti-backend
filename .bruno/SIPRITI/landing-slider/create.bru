meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{host}}/api/landing-slider/
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}


body:multipart-form {
  title: Slider Utama
  description: Deskripsi slider
  btn_text: Selengkapnya
  btn_link: /penelitian
  btn_color: #3b82f6
  order_index: 1
  status: active
  img_desktop: @file(./sample.jpg)
  img_mobile: @file(./sample-mobile.jpg)
}
