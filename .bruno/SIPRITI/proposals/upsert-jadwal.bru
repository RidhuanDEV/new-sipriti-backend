meta {
  name: Bulk Upsert Jadwal Kegiatan
  type: http
  seq: 6
}

put {
  url: {{host}}/api/proposals/:id/jadwal
  body: json
  auth: inherit
}

params:path {
  id: your-proposal-uuid-here
}

