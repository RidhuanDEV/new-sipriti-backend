meta {
  name: get-by-id
  type: http
  seq: 2
}

get {
  url: {{host}}/api/panduan/:id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: {{panduan_id}}
}

docs {
  # Get Panduan by ID
  
  ## API Endpoint
  `GET /api/panduan/:id`
  
  **Auth Required:** ✅  
  **Role Required:** All authenticated users
  
  ---
  
  ## DTO (Path Parameters)
  
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | id | UUID | ✅ | ID panduan |
  
  ---
  
  ## Response Structure
  
  ### Success (200)
  ```json
  {
    "success": true,
    "message": "Berhasil mengambil detail panduan",
    "data": {
      "id": "uuid-panduan",
      "judul": "Panduan Pengajuan Proposal",
      "isi_panduan": "<p>Langkah-langkah pengajuan...</p>",
      "file_url": "/uploads/panduan/panduan.pdf",
      "createdAt": "2025-01-15T10:00:00.000Z",
      "updatedAt": "2025-01-15T10:00:00.000Z"
    }
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|--------|
  | 401 | Token tidak valid |
  | 404 | Panduan tidak ditemukan |
}
