meta {
  name: delete
  type: http
  seq: 6
}

delete {
  url: {{host}}/api/carousel/:id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: {{carousel_id}}
}

docs {
  # Delete Carousel
  
  ## API Endpoint
  `DELETE /api/carousel/:id`
  
  **Auth Required:** ✅ Bearer Token  
  **Role Required:** Admin
  
  ---
  
  ## DTO (Path Parameters)
  
  | Param | Type | Required | Description |
  |-------|------|----------|-------------|
  | id | UUID | ✅ | ID carousel |
  
  ---
  
  ## Response Structure
  
  ### Success (200 OK)
  ```json
  {
    "success": true,
    "message": "Carousel berhasil dihapus"
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|---------|  
  | 401 | Token tidak valid |
  | 403 | Akses ditolak |
  | 404 | Carousel tidak ditemukan |
}
