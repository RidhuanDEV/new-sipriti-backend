meta {
  name: get-by-id
  type: http
  seq: 3
}

get {
  url: {{host}}/api/carousel/:id
  body: none
  auth: inherit
}

params:path {
  id: {{carousel_id}}
}

docs {
  # Get Carousel By ID
  
  ## API Endpoint
  `GET /api/carousel/:id`
  
  **Auth Required:** ❌ Public
  
  ---
  
  ## DTO (Path Parameters)
  
  | Param | Type | Required | Description |
  |-------|------|----------|-------------|
  | id | UUID | ✅ | ID carousel |
  
  ---
  
  ## Response Structure
  
  ### Success (200 OK)
  ```json
  {
    "success": true,
    "message": "Berhasil mengambil data carousel",
    "data": {
      "id": "uuid",
      "title": "Banner Title",
      "image_url": "/uploads/carousel/img.jpg",
      "is_active": true,
      "page": "capaian",
      "order": 1,
      "createdAt": "2025-01-08T10:00:00.000Z",
      "updatedAt": "2025-01-08T10:00:00.000Z"
    }
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|---------|  
  | 404 | Carousel tidak ditemukan |
}
