meta {
  name: update
  type: http
  seq: 4
}

put {
  url: {{host}}/api/pengumuman/:id
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: {{pengumuman_id}}
}

body:multipart-form {
  judul: Pengumuman Hibah Penelitian 2025 (Update)
  isi_pengumuman: <p>Dengan ini diumumkan bahwa batas waktu pendaftaran diperpanjang...</p>
  file: @file(path/to/lampiran-update.pdf)
}

docs {
  # Update Pengumuman
  
  ## API Endpoint
  `PUT /api/pengumuman/:id`
  
  **Auth Required:** ✅  
  **Role Required:** Admin
  
  ---
  
  ## DTO (Path Parameters)
  
  | Field | Type | Required | Description |
  |-------|------|----------|-------------|
  | id | UUID | ✅ | ID pengumuman |
  
  ## DTO (Request Body - multipart/form-data)
  
  ```typescript
  interface UpdatePengumumanDTO {
    judul: string;          // Required - Judul pengumuman
    isi_pengumuman: string; // Required - Isi pengumuman
    file?: File;            // Optional - File baru
    remove_file?: boolean;  // Optional - Hapus file
  }
  ```
  
  | Field | Type | Required | Validation |
  |-------|------|----------|------------|
  | judul | string | ✅ | Tidak boleh kosong |
  | isi_pengumuman | string | ✅ | Tidak boleh kosong |
  | file | File | ❌ | PDF/Doc |
  | remove_file | boolean | ❌ | true untuk hapus file |
  
  ---
  
  ## Response Structure
  
  ### Success (200)
  ```json
  {
    "success": true,
    "message": "Pengumuman berhasil diupdate",
    "data": {
      "id": "uuid-pengumuman",
      "judul": "Pengumuman Hibah Penelitian 2025 (Update)",
      "isi_pengumuman": "<p>Dengan ini diumumkan...</p>",
      "file_url": "/uploads/pengumuman/lampiran-update.pdf",
      "createdAt": "2025-01-15T10:00:00.000Z",
      "updatedAt": "2025-01-16T10:00:00.000Z"
    }
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|--------|
  | 400 | Judul wajib diisi |
  | 400 | Isi Pengumuman wajib diisi |
  | 400 | Judul tidak boleh kosong |
  | 400 | Isi pengumuman tidak boleh kosong |
  | 401 | Token tidak valid |
  | 403 | Akses ditolak |
  | 404 | Pengumuman tidak ditemukan |
}
