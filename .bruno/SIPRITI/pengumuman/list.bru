  token: {{token}}
}

params:query {
  page: 1
  limit: 10
}

docs {
  # List Pengumuman
  
  ## API Endpoint
  `GET /api/pengumuman`
  
  **Auth Required:** ✅  
  **Role Required:** All authenticated users
  
  ---
  
  ## DTO (Query Parameters)
  
  ```typescript
  interface ListPengumumanQuery {
    page?: number;   // Default: 1
    limit?: number;  // Default: 10, Max: 200
    search?: string; // Pencarian judul
  }
  ```
  
  | Field | Type | Required | Default | Description |
  |-------|------|----------|---------|-------------|
  | page | number | ❌ | 1 | Halaman |
  | limit | number | ❌ | 10 | Jumlah per halaman |
  | search | string | ❌ | - | Pencarian judul |
  
  ---
  
  ## Response Structure
  
  ### Success (200)
  ```json
  {
    "success": true,
    "message": "Berhasil mengambil daftar pengumuman",
    "data": [
      {
        "id": "uuid-pengumuman",
        "judul": "Pengumuman Hibah Penelitian 2025",
        "isi_pengumuman": "<p>Dengan ini diumumkan...</p>",
        "file_url": "/uploads/pengumuman/doc.pdf",
        "createdAt": "2025-01-15T10:00:00.000Z",
        "updatedAt": "2025-01-15T10:00:00.000Z"
      }
    ],
    "meta": {
      "page": 1,
      "limit": 10,
      "totalRows": 5,
      "totalPages": 1
    }
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|--------|
  | 401 | Token tidak valid |
}
