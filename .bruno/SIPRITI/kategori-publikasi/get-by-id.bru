meta {
  name: get-by-id
  type: http
  seq: 2
}

get {
  url: {{host}}/api/kategori-publikasi/:id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: {{kategori_publikasi_id}}
}

docs {
  # Get Kategori Publikasi by ID
  
  ## API Endpoint
  `GET /api/kategori-publikasi/:id`
  
  **Auth Required:** ✅ Bearer Token  
  **Roles:** admin, dosen, mahasiswa
  
  ---
  
  ## DTO (Path Parameters)
  
  | Param | Type | Required | Description |
  |-------|------|----------|-------------|
  | id | UUID | ✅ | ID kategori |
  
  ---
  
  ## Response Structure
  
  ### Success (200 OK)
  ```json
  {
    "success": true,
    "message": "Berhasil mengambil kategori publikasi",
    "data": {
      "id": "uuid",
      "nama": "Jurnal Internasional",
      "keterangan": "Deskripsi",
      "createdAt": "2025-01-08T10:00:00.000Z"
    }
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|---------|  
  | 401 | Token tidak valid |
  | 404 | Kategori tidak ditemukan |
}
