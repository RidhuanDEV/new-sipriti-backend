meta {
  name: List Berita (Public)
  type: http
  seq: 1
}

get {
  url: {{host}}/api/publicpage/berita
  body: none
  auth: none
}

params:query {
  ~page: 1
  ~limit: 10
  ~search: Penelitian
}

docs {
  # GET /api/publicpage/berita

  Mengambil daftar berita untuk halaman publik. Tidak memerlukan autentikasi.

  ## Query Parameters

  | Parameter | Type | Default | Description |
  |-----------|------|---------|-------------|
  | page | number | 1 | Halaman saat ini |
  | limit | number | 10 | Jumlah item per halaman |
  | search | string | "" | Cari berdasarkan judul |

  ## Response Success (200)

  ```json
  {
    "success": true,
    "message": "Data berita berhasil diambil",
    "data": [
      {
        "id": "uuid",
        "judul": "Penelitian Inovatif ITI Raih Pendanaan Nasional",
        "slug": "penelitian-inovatif-iti-raih-pendanaan-nasional",
        "ringkasan": "Ringkasan singkat berita...",
        "thumbnail": "/uploads/images/berita-thumb.jpg",
        "publishedAt": "2025-01-08T00:00:00.000Z"
      }
    ],
    "meta": {
      "pagination": {
        "currentPage": 1,
        "totalPages": 3,
        "totalItems": 25,
        "itemsPerPage": 10
      }
    }
  }
  ```
}
