meta {
  name: List Panduan (Public)
  type: http
  seq: 5
}

get {
  url: {{host}}/api/publicpage/panduan
  body: none
  auth: none
}

params:query {
  ~page: 1
  ~limit: 10
  ~search: Proposal
}

docs {
  # GET /api/publicpage/panduan

  Mengambil daftar panduan untuk halaman publik. Tidak memerlukan autentikasi.

  ## Query Parameters

  | Parameter | Type | Default | Description |
  |-----------|------|---------|-------------|
  | page | number | 1 | Halaman saat ini |
  | limit | number | 10 | Jumlah item per halaman |
  | search | string | "" | Cari berdasarkan judul |

  ## Response Success (200)

  ```json
  {
    "success": true,
    "message": "Data panduan berhasil diambil",
    "data": [
      {
        "id": "uuid",
        "judul": "Panduan Pengajuan Proposal Penelitian",
        "deskripsi": "Langkah-langkah pengajuan proposal...",
        "file_url": "/uploads/panduan/panduan-proposal.pdf",
        "createdAt": "2025-01-08T00:00:00.000Z"
      }
    ],
    "meta": {
      "pagination": {
        "currentPage": 1,
        "totalPages": 1,
        "totalItems": 5,
        "itemsPerPage": 10
      }
    }
  }
  ```
}
