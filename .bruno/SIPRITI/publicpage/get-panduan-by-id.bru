meta {
  name: Get Panduan by ID (Public)
  type: http
  seq: 6
}

get {
  url: {{host}}/api/publicpage/panduan/:id
  body: none
  auth: none
}

params:path {
  id: your-panduan-uuid-here
}

docs {
  # GET /api/publicpage/panduan/:id

  Mengambil detail satu panduan berdasarkan ID. Tidak memerlukan autentikasi.

  ## Path Parameters

  | Parameter | Type | Description |
  |-----------|------|-------------|
  | id | UUID | ID panduan |

  ## Response Success (200)

  ```json
  {
    "success": true,
    "message": "Detail panduan berhasil diambil",
    "data": {
      "id": "uuid",
      "judul": "Panduan Pengajuan Proposal Penelitian",
      "deskripsi": "Langkah-langkah pengajuan proposal...",
      "konten": "<p>Isi panduan lengkap dalam HTML...</p>",
      "file_url": "/uploads/panduan/panduan-proposal.pdf",
      "createdAt": "2025-01-08T00:00:00.000Z",
      "updatedAt": "2025-01-08T00:00:00.000Z"
    }
  }
  ```

  ## Error Responses

  | Status | Message |
  |--------|---------|
  | 404 | Panduan tidak ditemukan |
}
