meta {
  name: Get Pengumuman by Slug (Public)
  type: http
  seq: 4
}

get {
  url: {{host}}/api/publicpage/pengumuman/:slug
  body: none
  auth: none
}

params:path {
  slug: jadwal-pengumpulan-proposal-penelitian-2025
}

docs {
  # GET /api/publicpage/pengumuman/:slug

  Mengambil detail satu pengumuman berdasarkan slug. Tidak memerlukan autentikasi.

  ## Path Parameters

  | Parameter | Type | Description |
  |-----------|------|-------------|
  | slug | string | Slug URL pengumuman |

  ## Response Success (200)

  ```json
  {
    "success": true,
    "message": "Detail pengumuman berhasil diambil",
    "data": {
      "id": "uuid",
      "judul": "Jadwal Pengumpulan Proposal Penelitian 2025",
      "slug": "jadwal-pengumpulan-proposal-penelitian-2025",
      "konten": "<p>Isi pengumuman lengkap dalam HTML...</p>",
      "publishedAt": "2025-01-08T00:00:00.000Z"
    }
  }
  ```

  ## Error Responses

  | Status | Message |
  |--------|---------|
  | 404 | Pengumuman tidak ditemukan |
}
