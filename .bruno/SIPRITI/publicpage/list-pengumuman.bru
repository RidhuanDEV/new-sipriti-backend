meta {
  name: List Pengumuman (Public)
  type: http
  seq: 3
}

get {
  url: {{host}}/api/publicpage/pengumuman
  body: none
  auth: none
}

params:query {
  ~page: 1
  ~limit: 10
  ~search: Jadwal
}

docs {
  # GET /api/publicpage/pengumuman

  Mengambil daftar pengumuman untuk halaman publik. Tidak memerlukan autentikasi.

  ## Query Parameters

  | Parameter | Type | Default | Description |
  |-----------|------|---------|-------------|
  | page | number | 1 | Halaman saat ini |
  | limit | number | 10 | Jumlah item per halaman |
  | search | string | "" | Cari berdasarkan judul |

  ## Response Success (200)

  ```json
  {
    "success": true,
    "message": "Data pengumuman berhasil diambil",
    "data": [
      {
        "id": "uuid",
        "judul": "Jadwal Pengumpulan Proposal Penelitian 2025",
        "slug": "jadwal-pengumpulan-proposal-penelitian-2025",
        "ringkasan": "Batas akhir pengumpulan proposal...",
        "publishedAt": "2025-01-08T00:00:00.000Z"
      }
    ],
    "meta": {
      "pagination": {
        "currentPage": 1,
        "totalPages": 2,
        "totalItems": 12,
        "itemsPerPage": 10
      }
    }
  }
  ```
}
