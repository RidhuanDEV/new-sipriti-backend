meta {
  name: get-by-id
  type: http
  seq: 2
}

get {
  url: {{host}}/api/hibah-internal/:id
  body: none
  auth: inherit
}

params:path {
  id: {{hibah_id}}
}

docs {
  # Get Hibah Internal By ID
  
  ## API Endpoint
  `GET /api/hibah-internal/:id`
  
  **Auth Required:** ❌ Public
  
  ---
  
  ## DTO (Path Parameters)
  
  | Param | Type | Required | Description |
  |-------|------|----------|-------------|
  | id | UUID | ✅ | ID hibah internal |
  
  ---
  
  ## Response Structure
  
  ### Success (200 OK)
  ```json
  {
    "success": true,
    "message": "Berhasil mengambil hibah internal",
    "data": {
      "id": "uuid",
      "tipe_hibah": "Penelitian",
      "judul_hibah": "Hibah Penelitian 2024",
      "susunan_tim_hibah": ["Dr. John Doe"],
      "tahun_hibah": "2024",
      "dana_hibah": 50000000,
      "createdAt": "2025-01-08T10:00:00.000Z"
    }
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|---------|  
  | 404 | Hibah internal tidak ditemukan |
}
