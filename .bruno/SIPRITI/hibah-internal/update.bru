put {
  url: {{host}}/api/hibah-internal/:id
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: {{hibah_id}}
}

body:json {
  {
    "tipe_hibah": "Pengabdian",
    "judul_hibah": "Judul Hibah Updated",
    "susunan_tim_hibah": ["Dr. John Doe"],
    "tahun_hibah": "2024",
    "dana_hibah": 75000000
  }
}

docs {
  # Update Hibah Internal
  
  ## API Endpoint
  `PUT /api/hibah-internal/:id`
  
  **Auth Required:** ✅ Bearer Token  
  **Role Required:** Admin
  
  ---
  
  ## DTO (Request)
  
  ### Path Parameters
  | Param | Type | Required |
  |-------|------|----------|
  | id | UUID | ✅ |
  
  ### Body (JSON)
  ```typescript
  interface UpdateHibahDTO {
    tipe_hibah?: string;
    judul_hibah?: string;
    susunan_tim_hibah?: string[];
    tahun_hibah?: string;
    dana_hibah?: number;
  }
  ```
  
  ---
  
  ## Response Structure
  
  ### Success (200 OK)
  ```json
  {
    "success": true,
    "message": "Berhasil mengupdate hibah internal",
    "data": { ... }
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|---------|  
  | 401 | Token tidak valid |
  | 403 | Akses ditolak |
  | 404 | Hibah internal tidak ditemukan |
}
