meta {
  name: delete
  type: http
  seq: 5
}

delete {
  url: {{host}}/api/hibah-internal/:id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: {{hibah_id}}
}

docs {
  # Delete Hibah Internal
  
  ## API Endpoint
  `DELETE /api/hibah-internal/:id`
  
  **Auth Required:** ✅ Bearer Token  
  **Role Required:** Admin
  
  ---
  
  ## DTO (Path Parameters)
  
  | Param | Type | Required | Description |
  |-------|------|----------|-------------|
  | id | UUID | ✅ | ID hibah internal |
  
  ---
  
  ## Response Structure
  
  ### Success (200 OK)
  ```json
  {
    "success": true,
    "message": "Berhasil menghapus hibah internal"
  }
  ```
  
  ---
  
  ## Error Responses
  
  | Status | Message |
  |--------|---------|  
  | 401 | Token tidak valid |
  | 403 | Akses ditolak |
  | 404 | Hibah internal tidak ditemukan |
}
