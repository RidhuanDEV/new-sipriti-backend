{
  "name": "backend",
  "version": "1.0.0",
  "description": "Opinionated modular Express + TypeScript backend starter with Sequelize, Zod, JWT auth, RBAC, caching, and CRUD generation.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias && node -e \"const fs = require('fs'); fs.mkdirSync('dist/database/seeders', { recursive: true }); fs.writeFileSync('dist/database/seeders/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "start": "node dist/server.js",
    "test": "tsx --test",
    "phase6:smoke": "tsx src/scripts/phase6-smoke-matrix.ts",
    "phase6:migration-check": "tsx src/scripts/phase6-migration-static-check.ts",
    "phase6:copy-legacy-fixture": "tsx src/scripts/phase6-copy-legacy-fixture.ts",
    "phase6:http-parity": "tsx src/scripts/phase6-http-parity.ts",
    "make:crud": "tsx src/scripts/generate-crud.ts",
    "api-docs": "tsx src/scripts/generate-swagger-schemas.ts",
    "db:migrate": "npm run build && npx sequelize-cli db:migrate",
    "db:migrate:undo": "npm run build && npx sequelize-cli db:migrate:undo",
    "db:seed": "npm run build && npx sequelize-cli db:seed:all",
    "db:seed:undo": "npm run build && npx sequelize-cli db:seed:undo:all"
  },
  "keywords": [
    "express",
    "typescript",
    "sequelize",
    "zod",
    "jwt",
    "rbac",
    "starter",
    "template",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@types/multer": "^2.1.0",
    "@types/pdfmake": "^0.2.12",
    "@types/sanitize-html": "^2.16.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.16.45",
    "mathjax-full": "^3.2.1",
    "multer": "^2.1.1",
    "mysql2": "^3.19.0",
    "pdfmake": "^0.2.15",
    "pino": "^10.3.1",
    "sanitize-html": "^2.17.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.0.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "sequelize-cli": "^6.6.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "sequelize": {
      "uuid": "^14.0.0"
    }
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
